.diary-list
  list-style: none
  padding: 0
  margin: 1.5em 0

.diary-item
  padding: 0.6em 0
  border-bottom: 1px solid #eee
  display: flex
  align-items: baseline
  gap: 1em

.diary-date
  color: #999
  font-size: 0.9em
  white-space: nowrap
  min-width: 7em

.diary-item a
  font-size: 1.05em
  text-decoration: none
  &:hover
    text-decoration: underline

// 日记正文中的转载引用块：与正文形成明显的视觉区分
.diary-post
  .content
    blockquote
      border-left: 3px solid $color-accent
      padding-left: 0.9em
      p
        & + p
          margin-top: 1em
