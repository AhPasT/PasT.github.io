.diary-list
  list-style: none
  padding: 0
  margin: 1.5em 0

.diary-item
  padding: 0.6em 0
  border-bottom: 1px solid #eee
  display: flex
  align-items: baseline
  gap: 1em

.diary-date
  color: #999
  font-size: 0.9em
  white-space: nowrap
  min-width: 7em

.diary-item a
  font-size: 1.05em
  text-decoration: none
  &:hover
    text-decoration: underline
