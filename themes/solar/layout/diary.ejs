<article class="post diary-post">
  <div class="content" itemprop="articleBody">
    <% if (page.type === 'diary') { %>
      <h1>随笔日记</h1>
      <ul class="diary-list">
        <% page.entries.forEach(function(entry) { %>
          <li class="diary-item">
            <span class="diary-date"><%= entry.date.format('YYYY-MM-DD') %></span>
            <a href="<%- url_for('/diary/' + entry.slug + '/') %>"><%= entry.title %></a>
          </li>
        <% }); %>
      </ul>
    <% } else if (page.type === 'diary-post') { %>
      <h1><%= page.entry.title %></h1>
      <span class="diary-date"><%= page.entry.date.format('YYYY-MM-DD') %></span>
      <%- markdown(page.entry.content) %>
      <% if (page.entry.slug === '2026-09-20-雨') { %>
      <!-- 稀疏细雨前端动效：仅本篇日记页面加载 -->
      <script src="/js/diary-rain.js"></script>
      <% } %>
      <% if (page.entry.slug.indexOf('2026-10-03') === 0) { %>
      <!-- 本篇日记专属：金句高亮 / 对话体排版样式 + 实况照片（jpg+mp4）渲染 -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-03.css') %>">
      <script src="<%- url_for('/js/diary-live.js') %>"></script>
      <% } %>
      <% if (page.entry.slug.indexOf('2026-10-05') === 0) { %>
      <!-- 本篇日记专属：开篇随笔卡片 + 实况照片（jpg+mp4）渲染与引话样式 -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-05.css') %>">
      <script src="<%- url_for('/js/diary-live.js') %>"></script>
      <% } %>
      <% if (page.entry.slug.indexOf('2026-10-06') === 0) { %>
      <!-- 本篇日记专属：开篇随笔卡片 + 实况照片（jpg+mp4）渲染 -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-06.css') %>">
      <script src="<%- url_for('/js/diary-live.js') %>"></script>
      <% } %>
      <% if (page.entry.slug.indexOf('2026-10-07') === 0) { %>
      <!-- 本篇日记专属：深黑「平行轨道」排版（暗底纵深 / 青绿实线＋紫罗兰虚线双轨 / 菱形节点 / 岔口斜线 / 琥珀收束句） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-07.css') %>">
      <% } %>
      <% if (page.entry.slug.indexOf('2026-10-10') === 0) { %>
      <!-- 本篇日记专属：《小雪》深夜失眠排版（墨蓝夜底 / 尘埃浮光 / 凌晨时间轴逐级增亮 / 三张散落卡片 / 结尾灰淡独行） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-10.css') %>">
      <% } %>
      <% if (page.entry.slug === '2026-10-16-不服') { %>
      <!-- 本篇日记专属：《不服》红涨绿跌情绪排版（三段正文绿→红竖条 / 情绪渐变条 / 持仓截图首绿末红描边） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-16.css') %>">
      <% } %>
      <% if (page.entry.slug === '2026-10-16-内观') { %>
      <!-- 本篇日记专属：《内观》烦躁→自省转折排版（吐槽段橙红 / 过渡细线 / 自省段青灰） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-16-neiguan.css') %>">
      <% } %>
      <% if (page.entry.slug === '2026-10-17-瞎子') { %>
      <!-- 本篇日记专属：《瞎子》主题纯黑沉浸排版（纯黑底 / 浅灰白诗行式排布 / 大留白，沉溺黑暗中） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-16-xiaci.css') %>">
      <% } %>
      <% if (page.entry.slug === '2026-10-17-休息') { %>
      <!-- 本篇日记专属：《休息》松弛夜感暖色排版（暗暖夜色底 / 琥珀微光标题 / 低饱和暖灰诗行 / 大留白收工感） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-17-xiuxi.css') %>">
      <% } %>
      <% if (page.entry.slug === '2026-10-18-我没喝多') { %>
      <!-- 本篇日记专属：《我没喝多》微醺倔强夜感排版（深夜墨蓝底 / 醉眼双影标题 / 竖屏视频轻微摇曳 / 时间轴播放器） -->
      <link rel="stylesheet" href="<%- url_for('/css/diary-2026-10-18-wo-mei-he-duo.css') %>">
      <script src="<%- url_for('/js/diary-2026-10-18-wo-mei-he-duo.js') %>"></script>
      <% } %>
      <p style="margin-top: 2em;"><a href="<%- url_for('/diary/') %>">← 返回日记列表</a></p>
    <% } %>
  </div>
</article>
